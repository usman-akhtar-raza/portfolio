---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-heading reveal">
  <p class="eyebrow"><span aria-hidden="true">//</span> {eyebrow}</p>
  <div class="section-heading-grid">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>
