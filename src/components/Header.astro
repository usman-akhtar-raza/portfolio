---
import Icon from './Icon.astro';

const links = [
  { href: '#about', label: 'Profile', index: '01' },
  { href: '#work', label: 'Work', index: '02' },
  { href: '#experience', label: 'Timeline', index: '03' },
  { href: '#contact', label: 'Contact', index: '04' },
];
---

<header class="topbar" data-header>
  <a class="topbar-mark" href="#top" aria-label="Usman Akhtar, back to top">
    <span>UA</span>
    <strong>Usman Akhtar</strong>
  </a>

  <p class="topbar-edition">Portfolio / Vol. 02 <span>— 2026</span></p>

  <p class="topbar-clock" aria-label="Current time in Lahore">
    PKT <time data-lahore-time>--:--</time>
  </p>

  <nav class="topbar-nav" aria-label="Primary navigation">
    {links.map((link) => <a href={link.href} data-nav-link>{link.label}</a>)}
  </nav>

  <a class="topbar-talk" href="mailto:akhtarusman716@gmail.com">
    Start a project <Icon name="arrow" class="size-4" />
  </a>

  <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-menu-button>
    <Icon name="menu" class="menu-open size-6" />
    <Icon name="close" class="menu-close size-6" />
  </button>

  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" data-mobile-nav>
    <p>Index / 2026</p>
    {links.map((link, index) => (
      <a href={link.href} style={`--index: ${index}`}>
        <span>{link.index}</span>{link.label}
      </a>
    ))}
    <a class="mobile-contact" href="mailto:akhtarusman716@gmail.com">
      akhtarusman716@gmail.com <Icon name="arrow" class="size-5" />
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const lahoreTime = document.querySelector<HTMLTimeElement>('[data-lahore-time]');

  const updateLahoreTime = () => {
    if (!lahoreTime) return;
    lahoreTime.textContent = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Karachi',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).format(new Date());
  };

  const closeMenu = () => {
    header?.classList.remove('menu-active');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation');
    document.body.classList.remove('menu-open');
  };

  updateLahoreTime();
  window.setInterval(updateLahoreTime, 30_000);

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    header?.classList.toggle('menu-active', !isOpen);
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
    document.body.classList.toggle('menu-open', !isOpen);
  });

  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900) closeMenu();
  });
</script>
