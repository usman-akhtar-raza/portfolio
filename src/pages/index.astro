---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';

const capabilities = [
  { number: '01', title: 'Product before pixels', description: 'I treat interfaces, APIs, data, and deployment as one product system—not disconnected tickets.' },
  { number: '02', title: 'AI with a job to do', description: 'LLM features should shorten a workflow, improve a decision, or unlock a real user capability.' },
  { number: '03', title: 'Built to survive production', description: 'Performance, maintainability, observability, and delivery are part of the build from day one.' },
];

const outcomes = [
  {
    index: '001', eyebrow: 'AI / Product integration', title: 'Generation features embedded where users already work.',
    description: 'Connected OpenAI services to an existing application so image and written-content generation became part of the product workflow—not a disconnected demo.',
    evidence: ['OpenAI API integration', 'Product-facing workflow', 'Production delivery'], stack: 'OPENAI API · NESTJS · REACT',
  },
  {
    index: '002', eyebrow: 'Full-stack / Performance', title: 'Features carried from interface to database.',
    description: 'Shipped work across React and Next.js interfaces, NestJS services, and MongoDB schemas while improving query behavior and API response times.',
    evidence: ['Frontend to backend ownership', 'Schema design', 'Query optimization'], stack: 'NEXT.JS · NESTJS · MONGODB',
  },
  {
    index: '003', eyebrow: 'Cloud / Delivery', title: 'Infrastructure that supports the product quietly.',
    description: 'Implemented secure S3 file workflows, supported backend deployment on EC2, and worked with Git reviews and CI/CD for repeatable releases.',
    evidence: ['Secure file uploads', 'Cloud deployment', 'Release workflow'], stack: 'AWS S3 · AWS EC2 · CI/CD',
  },
];

const experience = [
  {
    year: '2025—NOW', company: 'rulrr.com', location: 'Remote',
    roles: ['Frontend Engineer · Jul 2025—Present', 'Frontend Developer · Jun 2024—Present'],
    detail: 'Building and maintaining product-facing frontend experiences inside an active engineering team.',
  },
  {
    year: '2025', company: 'Syncrologik', location: 'Lahore / Remote',
    roles: ['Full-Stack Developer · Apr—Aug 2025', 'Full-Stack Developer Intern · May 2025—Present'],
    detail: 'Delivered full-stack features, database improvements, AWS infrastructure, and OpenAI-powered product functionality.',
  },
  {
    year: '2024', company: 'Independent', location: 'Remote', roles: ['Frontend Developer · Jan—Aug 2024'],
    detail: 'Built responsive Next.js and Tailwind CSS interfaces with a distributed multinational team.',
  },
];

const toolkit = [
  { label: 'Interface', items: ['React', 'Next.js', 'React Native', 'Tailwind CSS', 'Zustand'] },
  { label: 'Systems', items: ['Node.js', 'NestJS', 'Express.js', 'GraphQL', 'OpenAI API'] },
  { label: 'Data', items: ['MongoDB', 'PostgreSQL', 'MySQL', 'Prisma', 'Redis'] },
  { label: 'Delivery', items: ['AWS EC2', 'AWS S3', 'Git', 'CI/CD', 'TypeScript'] },
];

const schema = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Usman Akhtar',
  jobTitle: 'Software Engineer | Full-Stack & AI Application Engineer', email: 'mailto:akhtarusman716@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressRegion: 'Punjab', addressCountry: 'PK' },
  sameAs: ['https://www.linkedin.com/in/usman-akhtar-dev'],
  knowsAbout: ['Full-stack development', 'React', 'Next.js', 'NestJS', 'React Native', 'RAG', 'AI agents', 'AWS'],
};
---

<Layout
  title="Usman Akhtar — Full-Stack & AI Application Engineer"
  description="Portfolio of Usman Akhtar, a Lahore-based software engineer building production-ready web, mobile, and AI-powered applications."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  <Header />

  <main id="main-content">
    <section id="top" class="dossier-hero" aria-labelledby="hero-title">
      <div class="hero-register hero-enter">
        <span>Software engineer</span><span>Full-stack / Mobile / AI</span><span>Lahore, Pakistan</span>
        <span class="availability"><i aria-hidden="true"></i> Available for select work</span>
      </div>

      <h1 id="hero-title" class="identity-title" aria-label="Usman Akhtar">
        <span class="identity-line"><span>USMAN</span></span>
        <span class="identity-line identity-line-shift"><span>AKHTAR</span></span>
      </h1>

      <div class="hero-composition">
        <div class="hero-intro hero-enter">
          <p class="micro-label">Field note / 001</p>
          <p>I engineer useful software across the full product surface, from the first interaction to the system behind it.</p>
          <div class="hero-actions">
            <a href="#work">View selected evidence <Icon name="arrow" class="size-5" /></a>
            <a href="/Usman_Akhtar_Full_Stack_AI_Engineer_CV.pdf" download><Icon name="download" class="size-4" /> Resume PDF</a>
          </div>
        </div>

        <figure class="portrait-assembly hero-enter" data-portrait>
          <div class="portrait-window" data-portrait-frame>
            <img src="/images/usman-akhtar-studio.png" width="941" height="1672" alt="Usman Akhtar in formal attire against a dark emerald studio background" />
          </div>
          <figcaption>Usman Akhtar / 2026</figcaption>
          <span class="portrait-stamp">BUILD<br />WITH<br />INTENT</span>
        </figure>

        <aside class="hero-brief hero-enter">
          <p class="micro-label">Current practice</p>
          <p>Production web, mobile, and AI application engineering.</p>
          <dl>
            <div><dt>Since</dt><dd>2024</dd></div><div><dt>Mode</dt><dd>Remote</dd></div><div><dt>Bias</dt><dd>Shipping</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <div class="signal-ticker" aria-label="Core engineering disciplines">
      <div class="ticker-track">
        <span>PRODUCT ENGINEERING</span><i>✳</i><span>FULL-STACK SYSTEMS</span><i>✳</i><span>AI APPLICATIONS</span><i>✳</i><span>MOBILE EXPERIENCES</span><i>✳</i>
        <span aria-hidden="true">PRODUCT ENGINEERING</span><i aria-hidden="true">✳</i><span aria-hidden="true">FULL-STACK SYSTEMS</span><i aria-hidden="true">✳</i><span aria-hidden="true">AI APPLICATIONS</span><i aria-hidden="true">✳</i><span aria-hidden="true">MOBILE EXPERIENCES</span><i aria-hidden="true">✳</i>
      </div>
    </div>

    <section id="about" class="paper-section profile-section" data-section="about">
      <div class="section-rail reveal"><span>01</span><p>Profile</p></div>
      <div class="section-body">
        <header class="editorial-heading reveal">
          <p class="micro-label">How I approach the work</p>
          <h2>Product craft<br />meets <em>system thinking.</em></h2>
        </header>

        <div class="profile-copy reveal">
          <p class="drop-copy">I’m a software engineer focused on production ready products, not isolated screens, novelty AI demos, or architecture for its own sake.</p>
          <div>
            <p>My work spans React and Next.js interfaces, React Native applications, NestJS services, database design, cloud delivery, and practical OpenAI integrations.</p>
            <p>The common thread is ownership: understand the user problem, make the system legible, and carry the result into production.</p>
          </div>
        </div>

        <div class="principle-ledger">
          {capabilities.map((item, index) => (
            <article class="principle-row reveal" style={`--stagger: ${index * 65}ms`}>
              <span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="ink-section work-section" data-section="work">
      <div class="section-rail reveal"><span>02</span><p>Selected evidence</p></div>
      <div class="section-body">
        <header class="work-heading reveal">
          <p class="micro-label">No invented case studies</p>
          <h2>Work measured by<br /><em>what moved.</em></h2>
          <p>Selected production outcomes drawn directly from professional experience.</p>
        </header>

        <div class="work-ledger">
          {outcomes.map((item, index) => (
            <article class="work-row reveal" style={`--stagger: ${index * 70}ms`}>
              <div class="work-number">{item.index}</div>
              <div class="work-story">
                <p class="micro-label">{item.eyebrow}</p><h3>{item.title}</h3><p>{item.description}</p>
              </div>
              <div class="work-evidence">
                <p class="micro-label">Evidence</p><ul>{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul><span>{item.stack}</span>
              </div>
              <div class="work-arrow" aria-hidden="true"><Icon name="arrow" class="size-7" /></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="paper-section timeline-section" data-section="experience">
      <div class="section-rail reveal"><span>03</span><p>Timeline</p></div>
      <div class="section-body timeline-layout">
        <header class="timeline-intro reveal">
          <p class="micro-label">Experience / Education</p>
          <h2>Built in teams.<br />Sharpened by shipping.</h2>
          <p>Experience across frontend product work, full-stack systems, remote collaboration, and cloud delivery.</p>
          <a href="/Usman_Akhtar_Full_Stack_AI_Engineer_CV.pdf" download>Full resume <Icon name="arrow" class="size-4" /></a>
        </header>

        <div class="career-ledger">
          {experience.map((item, index) => (
            <article class="career-row reveal" style={`--stagger: ${index * 65}ms`}>
              <div class="career-year">{item.year}</div>
              <div class="career-company"><h3>{item.company}</h3><span>{item.location}</span></div>
              <div class="career-detail">{item.roles.map((role) => <strong>{role}</strong>)}<p>{item.detail}</p></div>
            </article>
          ))}

          <div class="education-strip reveal">
            <p class="micro-label">Education</p>
            <div><span>2022—2026</span><strong>Bachelor’s in Computer Software Engineering</strong><p>The Superior University</p></div>
            <div><span>2018—2020</span><strong>High School Diploma</strong><p>Academy for Academic Excellence</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="signal-section" aria-labelledby="toolkit-title">
      <div class="toolkit-header reveal">
        <p class="micro-label">Technical index / Actively used</p>
        <h2 id="toolkit-title">Tools are temporary.<br />Engineering judgment travels.</h2>
      </div>
      <div class="toolkit-ledger">
        {toolkit.map((group, groupIndex) => (
          <div class="toolkit-row reveal" style={`--stagger: ${groupIndex * 55}ms`}>
            <p>{group.label}</p>
            <div>{group.items.map((item, index) => <span style={`--item-index: ${index}`}>{item}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="contact" class="contact-section" data-section="contact">
      <div class="contact-register reveal"><span>04 / Contact</span><span>Lahore · Pakistan</span><span>Remote · Worldwide</span></div>
      <div class="contact-title reveal"><p>LET’S BUILD</p><p>SOMETHING</p><p><em>USEFUL.</em></p></div>
      <div class="contact-lower reveal">
        <p>I’m open to remote full-time, freelance, project-based, and long-term collaboration where thoughtful engineering matters.</p>
        <a href="mailto:akhtarusman716@gmail.com">akhtarusman716@gmail.com <Icon name="arrow" class="size-8" /></a>
      </div>
      <footer>
        <p>© <span data-year>2026</span> Usman Akhtar</p>
        <div><a href="https://www.linkedin.com/in/usman-akhtar-dev" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="/Usman_Akhtar_Full_Stack_AI_Engineer_CV.pdf" download>Resume ↓</a></div>
        <a href="#top">Back to top ↑</a>
      </footer>
    </section>
  </main>

  <script>
    const year = document.querySelector('[data-year]');
    if (year) year.textContent = String(new Date().getFullYear());

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
    const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
    const portrait = document.querySelector<HTMLElement>('[data-portrait]');
    const portraitFrame = document.querySelector<HTMLElement>('[data-portrait-frame]');

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      revealElements.forEach((element) => revealObserver.observe(element));

      let ticking = false;
      const updateProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar?.style.setProperty('--progress', String(max > 0 ? window.scrollY / max : 0));
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateProgress);
      }, { passive: true });
      updateProgress();

      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        portrait?.addEventListener('pointermove', (event) => {
          if (!portraitFrame || !portrait) return;
          const bounds = portrait.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          portraitFrame.style.setProperty('--rx', `${y * -1.5}deg`); portraitFrame.style.setProperty('--ry', `${x * 1.5}deg`);
          portraitFrame.style.setProperty('--tx', `${x * 5}px`); portraitFrame.style.setProperty('--ty', `${y * 5}px`);
        });
        portrait?.addEventListener('pointerleave', () => {
          ['--rx', '--ry'].forEach((property) => portraitFrame?.style.setProperty(property, '0deg'));
          ['--tx', '--ty'].forEach((property) => portraitFrame?.style.setProperty(property, '0px'));
        });
      }
    }

    const trackedSections = document.querySelectorAll<HTMLElement>('[data-section]');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = (entry.target as HTMLElement).dataset.section;
        navLinks.forEach((link) => link.classList.toggle('is-active', link.hash === `#${id}`));
      });
    }, { rootMargin: '-35% 0px -55% 0px' });
    trackedSections.forEach((section) => sectionObserver.observe(section));
  </script>
</Layout>
