    href: '/services/ai-application-development',
    meta: 'RAG · Generation · AI SaaS',
  },
];

const outcomes = [
  {
    index: '001', eyebrow: 'Rulrr 2.0 / Frontend engineering', title: 'A coherent product surface built for continued iteration.',
    description: 'Turned product requirements into responsive, reusable interface patterns while keeping states, behavior, and team delivery clear.',
    evidence: ['Component architecture', 'Responsive product states', 'Frontend delivery'], stack: 'FRONTEND · PRODUCT UI · TEAM DELIVERY',
    href: '/projects/rulrr-2-frontend-engineering',
  },
  {
    index: '002', eyebrow: 'Rulrr / Full-stack engineering', title: 'Content generation carried across the complete workflow.',
    description: 'Built across the product UI, backend orchestration, persistence, and delivery so generation behaved like a reliable product capability.',
    evidence: ['Full-stack workflow', 'AI service integration', 'Production delivery'], stack: 'FULL-STACK · AI INTEGRATION · SYSTEM DESIGN',
