      name: 'Usman Akhtar — Full-Stack Web & AI Application Engineer',
      dateModified: '2026-08-31T00:00:00+05:00',
      mainEntity: { '@id': personID },
      isPartOf: { '@id': `${siteURL}#website` },
    },
    {
      '@type': 'Person',
      '@id': personID,
      name: 'Usman Akhtar',
      url: siteURL,
