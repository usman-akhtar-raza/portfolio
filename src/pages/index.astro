---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';

const capabilities = [
  {
    number: '01',
    title: 'Full-stack product engineering',
    description: 'Production-minded interfaces, APIs, data models, and integrations built as one coherent product system.',
    tools: ['React', 'Next.js', 'NestJS', 'MongoDB'],
  },
  {
    number: '02',
    title: 'AI-enabled applications',
    description: 'Practical LLM features connected to real product workflows, from OpenAI integrations to RAG and AI agents.',
    tools: ['OpenAI API', 'RAG', 'AI Agents', 'LLMs'],
  },
  {
    number: '03',
    title: 'Mobile experiences',
    description: 'User-focused mobile application development with shared product thinking across web and native surfaces.',
    tools: ['React Native', 'TypeScript', 'Zustand'],
  },
  {
    number: '04',
    title: 'Cloud delivery',
    description: 'Backend deployment, secure file workflows, and consistent releases supported by practical cloud infrastructure.',
    tools: ['AWS EC2', 'AWS S3', 'Git', 'CI/CD'],
  },
];

const outcomes = [
  {
    index: '01',
    label: 'AI integration',
    title: 'Image and content generation inside a real application',
    description: 'Connected OpenAI services to a production application, enabling product users to generate image and written content inside an existing full-stack workflow.',
    tags: ['OpenAI API', 'NestJS', 'Product integration'],
  },
  {
    index: '02',
    label: 'Full-stack delivery',
    title: 'Production features from interface to database',
    description: 'Developed and shipped features across React and Next.js interfaces, NestJS backend services, and MongoDB schemas while improving API and query performance.',
    tags: ['React', 'Next.js', 'NestJS', 'MongoDB'],
  },
  {
    index: '03',
    label: 'Cloud infrastructure',
    title: 'Secure file handling and backend deployment on AWS',
    description: 'Implemented AWS S3 file uploads and supported backend service deployment on EC2, with Git-based reviews and CI/CD for reliable releases.',
    tags: ['AWS S3', 'AWS EC2', 'CI/CD'],
  },
];

const experience = [
  {
    company: 'rulrr.com',
    location: 'Remote',
    roles: [
      { title: 'Frontend Engineer', date: 'July 2025 — Present' },
      { title: 'Frontend Developer', date: 'June 2024 — Present' },
    ],
    description: 'Building and maintaining frontend product experiences as part of an active engineering team.',
  },
  {
    company: 'Syncrologik',
    location: 'Lahore / Remote',
    roles: [
      { title: 'Full-Stack Developer', date: 'April 2025 — August 2025' },
      { title: 'Full-Stack Developer Intern', date: 'May 2025 — Present' },
    ],
    description: 'Delivered full-stack features, database improvements, AWS infrastructure, and OpenAI-powered functionality for production applications.',
  },
  {
    company: 'Freelance',
    location: 'Remote',
    roles: [{ title: 'Frontend Developer', date: 'January 2024 — August 2024' }],
    description: 'Built responsive Next.js and Tailwind CSS interfaces while collaborating with a distributed multinational team.',
  },
];

const stackGroups = [
  { label: 'Languages', values: ['JavaScript', 'TypeScript', 'SQL'] },
  { label: 'Frontend & mobile', values: ['React', 'Next.js', 'React Native', 'Tailwind CSS', 'Zustand'] },
  { label: 'Backend & APIs', values: ['Node.js', 'NestJS', 'Express.js', 'GraphQL', 'OpenAI API'] },
  { label: 'Data & infrastructure', values: ['MongoDB', 'PostgreSQL', 'MySQL', 'Prisma ORM', 'Redis', 'AWS'] },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Usman Akhtar',
  jobTitle: 'Software Engineer | Full-Stack & AI Application Engineer',
  email: 'mailto:akhtarusman716@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
  sameAs: ['https://www.linkedin.com/in/usman-akhtar-dev'],
  knowsAbout: ['Full-stack development', 'React', 'Next.js', 'NestJS', 'React Native', 'RAG', 'AI agents', 'AWS'],
};
---

<Layout
  title="Usman Akhtar — Full-Stack & AI Application Engineer"
  description="Portfolio of Usman Akhtar, a Lahore-based software engineer building production-ready web, mobile, and AI-powered applications."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="site-shell" id="top">
    <Header />

    <main id="main-content">
      <section class="hero section-pad" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="availability reveal is-visible">
            <span class="status-dot" aria-hidden="true"></span>
            Open to remote & freelance work
          </p>
          <h1 id="hero-title" class="hero-title reveal is-visible">
            Engineering products<br />for the <em>intelligent web.</em>
          </h1>
          <p class="hero-intro reveal is-visible">
            I’m <strong>Usman Akhtar</strong>, a full-stack and AI application engineer turning complex ideas into dependable web, mobile, and AI-powered products.
          </p>
          <div class="hero-actions reveal is-visible">
            <a class="button button-primary" href="#work">
              Explore my work <Icon name="arrow" class="size-5" />
            </a>
            <a class="text-link" href="/Usman_Akhtar_Full_Stack_AI_Engineer_CV.pdf" download>
              <Icon name="download" class="size-5" /> Download résumé
            </a>
          </div>
        </div>

        <div class="portrait-wrap reveal is-visible">
          <div class="portrait-frame">
            <img src="/images/usman-akhtar.jpg" width="645" height="1147" alt="Usman Akhtar in formal attire" />
          </div>
          <div class="portrait-note">
            <span>Lahore, Pakistan</span>
            <span>31.5204° N</span>
          </div>
          <div class="orbit-label" aria-hidden="true">
            <Icon name="spark" class="size-4" />
            BUILD · LEARN · SHIP ·
          </div>
        </div>

        <div class="hero-meta reveal is-visible" aria-label="Professional overview">
          <div><span>Focus</span><strong>Web · Mobile · AI</strong></div>
          <div><span>Experience</span><strong>2024 — Present</strong></div>
          <div><span>Approach</span><strong>Product-minded</strong></div>
        </div>
      </section>

      <section id="about" class="section-pad about-section">
        <SectionHeading
          eyebrow="About"
          title="A full-stack perspective, from first interaction to final deployment."
          description="I work across product interfaces, backend systems, data, cloud services, and practical AI features—keeping the complete user experience in view."
        />

        <div class="capability-grid">
          {capabilities.map((capability) => (
            <article class="capability-card reveal">
              <span class="card-number">{capability.number}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
              <ul aria-label={`${capability.title} technologies`}>
                {capability.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="work" class="section-pad work-section">
        <SectionHeading
          eyebrow="Selected work"
          title="Engineering outcomes, not just screenshots."
          description="A selection of verified production work across AI integration, full-stack development, and cloud delivery."
        />

        <div class="outcome-list">
          {outcomes.map((outcome) => (
            <article class="outcome-card reveal">
              <div class="outcome-index">{outcome.index}</div>
              <div class="outcome-content">
                <p class="outcome-label">{outcome.label}</p>
                <h3>{outcome.title}</h3>
                <p>{outcome.description}</p>
                <ul>
                  {outcome.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <div class="outcome-mark" aria-hidden="true"><Icon name="arrow" class="size-6" /></div>
            </article>
          ))}
        </div>
      </section>

      <section id="experience" class="section-pad experience-section">
        <SectionHeading
          eyebrow="Experience"
          title="Building, learning, and shipping with real teams."
          description="Professional experience spanning product frontend, full-stack systems, cloud deployment, and remote collaboration."
        />

        <div class="experience-grid">
          <div class="timeline">
            {experience.map((item) => (
              <article class="timeline-item reveal">
                <div class="timeline-marker" aria-hidden="true"></div>
                <div class="timeline-heading">
                  <div><h3>{item.company}</h3><span>{item.location}</span></div>
                  <div class="role-list">
                    {item.roles.map((role) => (
                      <p><strong>{role.title}</strong><span>{role.date}</span></p>
                    ))}
                  </div>
                </div>
                <p class="timeline-description">{item.description}</p>
              </article>
            ))}
          </div>

          <aside class="education-card reveal">
            <p class="eyebrow"><span aria-hidden="true">//</span> Education</p>
            <div>
              <span>2022 — 2026</span>
              <h3>Bachelor’s in Computer Software Engineering</h3>
              <p>The Superior University</p>
            </div>
            <div>
              <span>2018 — 2020</span>
              <h3>High School Diploma</h3>
              <p>Academy for Academic Excellence</p>
            </div>
          </aside>
        </div>
      </section>

      <section class="section-pad stack-section" aria-labelledby="stack-title">
        <div class="stack-intro reveal">
          <p class="eyebrow"><span aria-hidden="true">//</span> Technical toolkit</p>
          <h2 id="stack-title">The right tools for the full product journey.</h2>
        </div>
        <div class="stack-groups">
          {stackGroups.map((group) => (
            <div class="stack-row reveal">
              <h3>{group.label}</h3>
              <ul>
                {group.values.map((value) => <li>{value}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="contact" class="contact-section section-pad">
        <div class="contact-inner reveal">
          <p class="eyebrow"><span aria-hidden="true">//</span> Start a project</p>
          <h2>Have a meaningful product in mind?</h2>
          <p>I’m open to remote full-time, freelance, project-based, and long-term collaboration opportunities.</p>
          <a class="contact-email" href="mailto:akhtarusman716@gmail.com">
            akhtarusman716@gmail.com <Icon name="arrow" class="size-8" />
          </a>
        </div>

        <footer class="footer">
          <p>© <span data-year>2026</span> Usman Akhtar</p>
          <div>
            <a href="https://www.linkedin.com/in/usman-akhtar-dev" target="_blank" rel="noreferrer">
              <Icon name="linkedin" class="size-4" /> LinkedIn
            </a>
            <a href="mailto:akhtarusman716@gmail.com">
              <Icon name="mail" class="size-4" /> Email
            </a>
          </div>
          <a href="#top">Back to top ↑</a>
        </footer>
      </section>
    </main>
  </div>

  <script>
    const year = document.querySelector('[data-year]');
    if (year) year.textContent = String(new Date().getFullYear());

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealElements = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries, revealObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

      revealElements.forEach((element) => observer.observe(element));
    }
  </script>
</Layout>
