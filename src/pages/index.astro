    index: '01',
    title: 'Full-stack web development',
    description: 'Responsive web applications, SaaS interfaces, admin panels, APIs, databases, and production delivery built as one maintainable product system.',
    href: '/services/web-development',
    meta: 'React · Next.js · Node.js',
  },
