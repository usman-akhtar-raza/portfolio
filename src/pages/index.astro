const ukWebsiteFaqs = [
  {
    question: 'How much does a small business website cost in the UK?',
    answer: 'The cost depends on the number of pages, design requirements, integrations, content, and whether you need a straightforward business website or a custom web application. After a short discovery call, I provide a clear proposal in GBP with the scope, milestones, and payment stages stated upfront.',
  },
  {
    question: 'How long does it take to build a business website?',
    answer: 'A focused marketing website can usually be delivered in a few weeks, while a SaaS product, booking workflow, admin panel, or complex integration needs a longer roadmap. I confirm a realistic timeline after reviewing the content, functionality, feedback process, and launch requirements.',
  },
  {
    question: 'Do I need a domain name and hosting before we start?',
    answer: 'No. We can choose the domain, hosting, and deployment setup during the project. If you already have them, I can work with the existing accounts. Wherever practical, the domain, hosting, analytics, and source-code access remain under your control.',
  },
  {
    question: 'Will my website be mobile-friendly and ready for SEO?',
    answer: 'Yes. Every build is designed for phones, tablets, and desktops, with accessible structure, fast-loading assets, crawlable pages, metadata, sitemap support, and technical SEO foundations. Search rankings also depend on competition, content, authority, and ongoing marketing, so no responsible developer can guarantee a specific position.',
  },
  {
    question: 'Can you redesign my existing website without losing its content or SEO?',
    answer: 'Yes. I can audit the current website, preserve valuable content and URLs, plan redirects where necessary, and rebuild the experience around clearer conversion paths. The migration approach is agreed before development so avoidable traffic and indexing issues are reduced.',
  },
  {
    question: 'Do you provide website maintenance and support after launch?',
    answer: 'Yes. A project can end with a documented handover or continue with an agreed support arrangement for monitoring, security updates, fixes, content changes, and new product iterations. The responsibilities and ongoing costs are made clear before launch.',
  },
  {
    question: 'Can you work remotely with a UK business or startup?',
    answer: 'Yes. I work remotely with agreed overlap for UK business hours, scheduled reviews, and written progress updates. You work directly with the engineer responsible for the interface, backend, data, and delivery rather than passing decisions through multiple layers.',
  },
];

const siteURL = 'https://www.usmandevhub.top/';
const personID = `${siteURL}#usman-akhtar`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: 'Usman Akhtar',
