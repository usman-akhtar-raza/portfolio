  { label: 'RAG SaaS platform', title: 'Lawvera', description: 'A final-year SaaS web application focused on retrieval-augmented generation and usable legal information workflows.', href: '/projects/lawvera-rag-saas-platform' },
];

const faqs = [
  { question: 'What kind of projects are a good fit?', answer: 'SaaS products, admin panels, business web applications, mobile-first workflows, and AI-enabled product features with a clear user outcome are the strongest fit.' },
  { question: 'Can you work with an existing codebase?', answer: 'Yes. I can review the current architecture, identify the safest path, and deliver a focused feature or improvement without forcing an unnecessary rewrite.' },
  { question: 'Do you work with UK and US teams?', answer: 'Yes. I work remotely from Lahore with asynchronous communication and agreed overlap for reviews, planning, and important delivery moments.' },
