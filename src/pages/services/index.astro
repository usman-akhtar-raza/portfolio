  { title: 'SaaS MVP engineering', description: 'Focused MVP development for startup teams that need to validate a workflow without creating a disposable technical foundation.' },
  { title: 'AI application development', description: 'RAG, content generation, and practical model integrations designed around a useful product workflow rather than an isolated demo.' },
];

const process = [
  { title: 'Define the outcome', description: 'Clarify the user, business goal, must-have workflow, constraints, and what a successful first release needs to prove.' },
  { title: 'Shape the system', description: 'Translate the brief into product states, data boundaries, API responsibilities, and an implementation sequence.' },
  { title: 'Build and validate', description: 'Deliver the product in reviewable increments, testing the real flow across interface, services, and data.' },
  { title: 'Prepare to operate', description: 'Complete production checks, document key decisions, and leave a maintainable path for the next release.' },
];

const evidence = [
  { label: 'Frontend engineering', title: 'Rulrr 2.0', description: 'Responsive product UI and reusable interface architecture built for continued iteration.', href: '/projects/rulrr-2-frontend-engineering' },
